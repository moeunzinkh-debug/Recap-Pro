{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recap-pro",
  "main": "worker.ts",
  "compatibility_date": "2025-08-15",
  // Frontend (dist/ from `vite build`) is served by Workers Static Assets.
  // The Worker handles /api/* and defers everything else to the ASSETS binding.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Raise the CPU limit (honored on Workers Paid; free plan stays at 10 ms).
  // JSON parsing of large frame payloads and long generations benefit from it.
  "limits": {
    "cpu_ms": 300000
  }
  // `npm run db:create` adds the "d1_databases" binding below automatically.
}
