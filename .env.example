# ── Recap Pro environment variables ──────────────────────────────────────
# Copy to .env for local development (npm run dev).
# On Cloudflare Workers, set these as secrets instead:
#   npx wrangler secret put GEMINI_API_KEY
#   npx wrangler secret put APP_SECRET

# GEMINI_API_KEY: Gemini AI API key.
# Optional — you can also enter it in the app's Settings page (ផ្ទាំងកំណត់),
# where it is stored encrypted in Cloudflare D1.
GEMINI_API_KEY=""

# APP_SECRET: Used to encrypt the Gemini API key at rest.
# Use a long random string in production.
APP_SECRET=""
